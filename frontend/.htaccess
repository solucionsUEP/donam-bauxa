Options -Indexes
RewriteEngine On

# Passa la capçalera Authorization al PHP (Apache la elimina per defecte)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No guardar en cache les respostes de l'API
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(api|auth)/#">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </If>
</IfModule>

# Redirigeix /api/* i /auth/* al router PHP (si no és un fitxer real)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(api|auth)/ api/index.php [L,QSA]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 hour"
  ExpiresByType application/json        "access plus 1 hour"
  ExpiresByType image/avif               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
