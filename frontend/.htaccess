Options -Indexes
RewriteEngine On

# Passa la capçalera Authorization al PHP (Apache la elimina per defecte)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No guardar en cache les respostes de l'API ni el version-check del SW
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(api|auth)/#">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </If>
  <If "%{REQUEST_URI} = '/version.json'">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </If>
  # Service worker must control the whole origin and never be cached.
  <If "%{REQUEST_URI} = '/sw.js'">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Service-Worker-Allowed "/"
  </If>
</IfModule>

# Redirigeix /api/*, /auth/* i /version.json al router PHP (si no és un fitxer real)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(api|auth)/ api/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^version\.json$ api/index.php [L,QSA]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml font/woff2
</IfModule>

# Cache headers — 1 year for all versioned static assets (SW handles invalidation)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType application/json        "access plus 1 hour"
  ExpiresByType image/avif               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Explicit Cache-Control for JS (some hosts serve .js as text/javascript, not application/javascript)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
